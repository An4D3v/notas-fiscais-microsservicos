{
  "Urls": "http://localhost:5002",
  "ConnectionStrings": {
    "Faturamento": "Server=(localdb)\\MSSQLLocalDB;Database=NotasFaturamento;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Estoque": {
    "BaseUrl": "http://localhost:5001",
    "Resiliencia": {
      "TimeoutPorTentativaSegundos": 2,
      "TimeoutTotalSegundos": 12,
      "MaxTentativas": 2,
      "EsperaInicialMs": 400,
      "JanelaDisjuntorSegundos": 30,
      "ProporcaoFalhaDisjuntor": 0.5,
      "MinimoChamadasDisjuntor": 4,
      "DuracaoAberturaDisjuntorSegundos": 10,
      "TimeoutConsultaSegundos": 3
    }
  },
  "Reconciliacao": {
    "IntervaloSegundos": 20,
    "IdadeMinimaSegundos": 60
  },
  "OrigensPermitidas": [ "http://localhost:4200" ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
